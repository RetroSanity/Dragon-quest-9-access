+/* tests: the keys the Access mod sees held, DQIX_ACCESS_KEYS="frame:Name+Name:frames;..."
+ * (BizHawk's names: "K", "PageDown", "LeftCtrl", "X1 LeftTrigger") */
+int frontend_access_input(const char** names, int max) {
+    static char* buf; static int init;
+    static struct { unsigned long long f; unsigned len; char* keys; } ev[256]; static int nev;
+    if (!init) {
+        init = 1;
+        const char* e = getenv("DQIX_ACCESS_KEYS");
+        if (e) {
+            buf = strdup(e);
+            for (char* t = strtok(buf, ";"); t && nev < 256; t = strtok(NULL, ";")) {
+                char* c1 = strchr(t, ':'); if (!c1) continue;
+                char* c2 = strchr(c1 + 1, ':');
+                *c1 = 0; ev[nev].f = strtoull(t, NULL, 10);
+                if (c2) { *c2 = 0; ev[nev].len = (unsigned)atoi(c2 + 1); } else ev[nev].len = 3;
+                ev[nev].keys = c1 + 1; nev++;
+            }
+        }
+    }
+    int n = 0;
+    for (int i = 0; i < nev; i++) {
+        if (g_frame < ev[i].f || g_frame >= ev[i].f + ev[i].len) continue;
+        static char tmp[256][64]; static int ti;
+        const char* k = ev[i].keys;
+        while (*k && n < max) {
+            const char* plus = strchr(k, '+');
+            size_t l = plus ? (size_t)(plus - k) : strlen(k);
+            if (l > 63) l = 63;
+            char* d = tmp[ti++ & 255]; memcpy(d, k, l); d[l] = 0;
+            names[n++] = d;
+            k += l + (plus ? 1 : 0);
+        }
+    }
+    return n;
+}
