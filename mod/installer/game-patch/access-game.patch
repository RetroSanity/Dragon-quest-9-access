+/* ---------------------------------------------------------------- Access mod
+ * The keys the script uses (most letters, Page Up / Down, Home, End, Ctrl)
+ * and the controller's left trigger and stick clicks are its own: the
+ * program's shortcuts on them are taken off. Without a controls.ini of the
+ * player's own, the DS's buttons are on the keys the Access mod's players
+ * know from the DS version: Z = A, X = B, A = X, S = Y, Q = L, E = R. */
+static int access_owned_key(int key) {
+    if (!key) return 0;
+    int sc = key & 0xFFFF, mods = key >> 16;
+    if (sc >= SDL_SCANCODE_A && sc <= SDL_SCANCODE_Z) return !(mods & (CTL_MOD_CTRL >> 16));   /* Ctrl+R (reset) stays */
+    return sc == SDL_SCANCODE_PAGEUP || sc == SDL_SCANCODE_PAGEDOWN || sc == SDL_SCANCODE_HOME || sc == SDL_SCANCODE_END ||
+           sc == SDL_SCANCODE_LCTRL || sc == SDL_SCANCODE_RCTRL;
+}
+static void access_controls(void) {
+    FILE* f = fopen("controls.ini", "r");
+    if (f) fclose(f);
+    else {
+#define K(a, k0) (g_ctl_key[a][0] = (k0), g_ctl_key[a][1] = 0)
+        K(CA_A, SDL_SCANCODE_Z); K(CA_B, SDL_SCANCODE_X); K(CA_X, SDL_SCANCODE_A); K(CA_Y, SDL_SCANCODE_S);
+        K(CA_L, SDL_SCANCODE_Q); K(CA_R, SDL_SCANCODE_E);
+#undef K
+    }
+    for (int a = CA_N_DS; a < CA_N; a++) {
+        for (int k = 0; k < 2; k++) if (access_owned_key(g_ctl_key[a][k])) g_ctl_key[a][k] = 0;
+        int p = g_ctl_pad[a];
+        if (p == CTL_PAD_LT || p == SDL_CONTROLLER_BUTTON_LEFTSTICK || p == SDL_CONTROLLER_BUTTON_RIGHTSTICK) g_ctl_pad[a] = CTL_NONE;
+    }
+    if (!g_ctl_key[CA_PAUSE][0] && !g_ctl_key[CA_PAUSE][1]) g_ctl_key[CA_PAUSE][0] = SDL_SCANCODE_PAUSE;
+}
+
+/* BizHawk's names for the keys and the controller's buttons held now (access.h) */
+int frontend_access_input(const char** names, int max) {
+    int n = 0;
+    if (!g_win || !(SDL_GetWindowFlags(g_win) & SDL_WINDOW_INPUT_FOCUS)) {
+        if (!(g_win2 && (SDL_GetWindowFlags(g_win2) & SDL_WINDOW_INPUT_FOCUS))) goto pad;
+    }
+    {
+        static char letters[26][2], digits[10][3], fkeys[12][4];
+        static int init;
+        if (!init) {
+            init = 1;
+            for (int i = 0; i < 26; i++) { letters[i][0] = (char)('A' + i); letters[i][1] = 0; }
+            for (int i = 0; i < 10; i++) snprintf(digits[i], sizeof digits[i], "D%d", i);
+            for (int i = 0; i < 12; i++) snprintf(fkeys[i], sizeof fkeys[i], "F%d", i + 1);
+        }
+        int nk = 0;
+        const Uint8* ks = SDL_GetKeyboardState(&nk);
+        for (int sc = 0; sc < nk && n < max; sc++) {
+            if (!ks[sc]) continue;
+            const char* nm = NULL;
+            if (sc >= SDL_SCANCODE_A && sc <= SDL_SCANCODE_Z) nm = letters[sc - SDL_SCANCODE_A];
+            else if (sc >= SDL_SCANCODE_1 && sc <= SDL_SCANCODE_9) nm = digits[sc - SDL_SCANCODE_1 + 1];
+            else if (sc == SDL_SCANCODE_0) nm = digits[0];
+            else if (sc >= SDL_SCANCODE_F1 && sc <= SDL_SCANCODE_F12) nm = fkeys[sc - SDL_SCANCODE_F1];
+            else switch (sc) {
+                case SDL_SCANCODE_PAGEUP: nm = "PageUp"; break;
+                case SDL_SCANCODE_PAGEDOWN: nm = "PageDown"; break;
+                case SDL_SCANCODE_HOME: nm = "Home"; break;
+                case SDL_SCANCODE_END: nm = "End"; break;
+                case SDL_SCANCODE_INSERT: nm = "Insert"; break;
+                case SDL_SCANCODE_DELETE: nm = "Delete"; break;
+                case SDL_SCANCODE_UP: nm = "Up"; break;
+                case SDL_SCANCODE_DOWN: nm = "Down"; break;
+                case SDL_SCANCODE_LEFT: nm = "Left"; break;
+                case SDL_SCANCODE_RIGHT: nm = "Right"; break;
+                case SDL_SCANCODE_RETURN: case SDL_SCANCODE_KP_ENTER: nm = "Enter"; break;
+                case SDL_SCANCODE_SPACE: nm = "Space"; break;
+                case SDL_SCANCODE_TAB: nm = "Tab"; break;
+                case SDL_SCANCODE_BACKSPACE: nm = "Backspace"; break;
+                case SDL_SCANCODE_ESCAPE: nm = "Escape"; break;
+                case SDL_SCANCODE_LCTRL: nm = "LeftCtrl"; break;
+                case SDL_SCANCODE_RCTRL: nm = "RightCtrl"; break;
+                case SDL_SCANCODE_LSHIFT: nm = "LeftShift"; break;
+                case SDL_SCANCODE_RSHIFT: nm = "RightShift"; break;
+                case SDL_SCANCODE_LALT: nm = "LeftAlt"; break;
+                case SDL_SCANCODE_RALT: nm = "RightAlt"; break;
+                case SDL_SCANCODE_MINUS: nm = "Minus"; break;
+                case SDL_SCANCODE_EQUALS: nm = "Equals"; break;
+                case SDL_SCANCODE_GRAVE: nm = "Grave"; break;
+                default: break;
+            }
+            if (nm) names[n++] = nm;
+        }
+    }
+pad:
+    if (g_pad) {
+        static const struct { int b; const char* nm; } B[] = {
+            { SDL_CONTROLLER_BUTTON_A, "X1 A" }, { SDL_CONTROLLER_BUTTON_B, "X1 B" }, { SDL_CONTROLLER_BUTTON_X, "X1 X" }, { SDL_CONTROLLER_BUTTON_Y, "X1 Y" },
+            { SDL_CONTROLLER_BUTTON_BACK, "X1 Back" }, { SDL_CONTROLLER_BUTTON_START, "X1 Start" },
+            { SDL_CONTROLLER_BUTTON_LEFTSTICK, "X1 LeftThumb" }, { SDL_CONTROLLER_BUTTON_RIGHTSTICK, "X1 RightThumb" },
+            { SDL_CONTROLLER_BUTTON_LEFTSHOULDER, "X1 LeftShoulder" }, { SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, "X1 RightShoulder" },
+            { SDL_CONTROLLER_BUTTON_DPAD_UP, "X1 DpadUp" }, { SDL_CONTROLLER_BUTTON_DPAD_DOWN, "X1 DpadDown" },
+            { SDL_CONTROLLER_BUTTON_DPAD_LEFT, "X1 DpadLeft" }, { SDL_CONTROLLER_BUTTON_DPAD_RIGHT, "X1 DpadRight" },
+        };
+        for (size_t i = 0; i < sizeof B / sizeof B[0] && n < max; i++)
+            if (SDL_GameControllerGetButton(g_pad, (SDL_GameControllerButton)B[i].b)) names[n++] = B[i].nm;
+        if (n < max && SDL_GameControllerGetAxis(g_pad, SDL_CONTROLLER_AXIS_TRIGGERLEFT) > 12000) names[n++] = "X1 LeftTrigger";
+        if (n < max && SDL_GameControllerGetAxis(g_pad, SDL_CONTROLLER_AXIS_TRIGGERRIGHT) > 12000) names[n++] = "X1 RightTrigger";
+    }
+    return n;
+}
